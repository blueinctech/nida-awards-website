{
  "name": "nida-awards-website",
  "version": "2.0.0",
  "private": true,
  "description": "NIDA \u2013 Nigerians in Diaspora Awards website and admin CMS (Next.js)",
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/migrate.ts && next build --webpack",
    "start": "next start",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:backup": "tsx scripts/backup.ts",
    "db:copy": "tsx scripts/copy-database.ts",
    "media:move-to-s3": "tsx scripts/move-blob-to-s3.ts",
    "move:check": "tsx scripts/check-move.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "images": "python3 tools/optimize_images.py && python3 tools/make_hero_wall.py && python3 tools/make_og.py",
    "share-images": "node tools/make_share.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1176.0",
    "@aws-sdk/client-sesv2": "^3.1176.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "marked": "^18.1.3",
    "next": "^16.4.6",
    "postgres": "^4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20.9.0 <25"
  }
}
