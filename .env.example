# Copy to .env.local (exactly that name) and fill in. Never commit real values.
# On Hostinger, set the same names in hPanel → your Node.js app → Environment variables.

# New Neon Postgres connection string (pooled, ends with ?sslmode=require)
DATABASE_URL=

# Amazon S3 bucket for uploaded images and documents.
# Leave S3_BUCKET empty locally to save uploads to .data/uploads instead.
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: CloudFront or custom address for public files
S3_PUBLIC_URL=

# Email through Amazon SES (uses the AWS keys above). Sender on the domain verified in SES,
# for example: NIDA <admin@nida-awards.org>
EMAIL_FROM=
EMAIL_REPLY_TO=
# Optional: only if SES is in a different region from the bucket
SES_REGION=

# Address used in emailed links, and the canonical public address
ADMIN_URL=https://nida-awards.org
SITE_URL=https://nida-awards.org

# Secret code for /admin/setup (16+ characters). Only needed to create the first Super Admin.
ADMIN_SETUP_TOKEN=

# Only on your own computer, only for the one-time move from Vercel (npm run db:copy):
# the old database that Vercel created
SOURCE_DATABASE_URL=
