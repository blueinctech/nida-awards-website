# Copy to .env.local and fill in. Never commit real values.

# Postgres connection string (Neon on Vercel sets this automatically)
DATABASE_URL=

# Vercel Blob store for uploads (set automatically when the Blob store is connected).
# Leave empty locally: files are then saved to .data/uploads
BLOB_READ_WRITE_TOKEN=

# Secret code for /admin/setup (16+ characters). Only needed to create the first Super Admin.
ADMIN_SETUP_TOKEN=

# Optional: send invitations, password resets and submission alerts with Resend
RESEND_API_KEY=
EMAIL_FROM=

# Optional: address used in emailed links, and the canonical public address
ADMIN_URL=
SITE_URL=
