# ─────────────────────────────────────────────────────────────────────────────
# NIDA Awards: settings for the ONE-TIME move from Vercel, used on your own computer.
#
# Save the filled-in copy as  .env.local  in the website folder on your PC
# (exactly ".env.local", not ".env.local.txt": in Notepad choose "Save as type: All files").
# Then follow deploy/MOVE-TO-HOSTINGER.md. Never upload this file to Hostinger and never
# commit it: it holds the old Vercel secrets as well as the new ones.
# ─────────────────────────────────────────────────────────────────────────────

# OLD database (Vercel → project → Storage → the Neon database → .env.local tab, or
# Settings → Environment Variables → DATABASE_URL). Read only: nothing is changed in it.
SOURCE_DATABASE_URL=

# OLD Blob store token (Vercel → Storage → the Blob store → .env.local tab → BLOB_READ_WRITE_TOKEN,
# starts with vercel_blob_rw_). Lets the move copy EVERY file in the store. Read only.
BLOB_READ_WRITE_TOKEN=

# NEW services: the same values as in hostinger.env
DATABASE_URL=
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
EMAIL_FROM="NIDA Awards <admin@nida-awards.org>"
SES_REGION=
ADMIN_URL=https://nida-awards.org
SITE_URL=https://nida-awards.org
