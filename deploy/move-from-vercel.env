# ─────────────────────────────────────────────────────────────────────────────
# NIDA Awards: ONE-TIME move from Vercel, used on your own computer only.
# Save the filled-in copy as .env.local in the website folder (git-ignored).
# Never upload it to Hostinger: it holds the old Vercel secrets as well as the new ones.
# ─────────────────────────────────────────────────────────────────────────────

# OLD database (Vercel → project → Settings → Environment Variables → DATABASE_URL). Read only.
SOURCE_DATABASE_URL=
# OLD Blob store token (Vercel → Storage → the Blob store → .env.local tab, starts with vercel_blob_rw_). Read only.
BLOB_READ_WRITE_TOKEN=

# NEW services: the same values as in .env.hostinger
DATABASE_URL=
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SES_REGION=us-east-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
EMAIL_FROM="NIDA Awards <admin@nida-awards.org>"
ADMIN_URL=https://nida-awards.org
SITE_URL=https://nida-awards.org
