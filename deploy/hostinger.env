# ─────────────────────────────────────────────────────────────────────────────
# NIDA Awards website: settings for Hostinger
#
# 1. Fill in every line that is empty. Do not put spaces around "=".
#    If a value contains spaces or a # sign, put it in double quotes.
# 2. Save the filled-in copy as  .env  (a file named just ".env") and upload it to
#    the website's main folder on Hostinger, next to package.json.
#    (If you deploy from GitHub in hPanel, paste the same lines into
#    hPanel → your Node.js app → Environment variables instead.)
# 3. Never commit the filled-in file, email it or paste it in chat.
#    The repository ignores .env files, so it cannot be committed by accident.
# ─────────────────────────────────────────────────────────────────────────────

# Neon: the NEW project → Connect → tick "Connection pooling" → copy the string.
# Looks like postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Amazon S3 bucket for images and documents
S3_BUCKET=
# Region code of the bucket, e.g. eu-west-2 (London), eu-central-1 (Frankfurt), us-east-1
AWS_REGION=
# Access key of the IAM user for the website (S3 + SES permissions)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: a CloudFront / custom address for public images. Leave empty to use the bucket address.
S3_PUBLIC_URL=

# Email through Amazon SES. The sender must be on a domain verified in SES.
EMAIL_FROM="NIDA Awards <admin@nida-awards.org>"
# Optional: where replies go
EMAIL_REPLY_TO=
# Optional: only if SES is set up in a different region from the bucket
SES_REGION=

# The website address (used in emailed links, share previews and the sitemap)
ADMIN_URL=https://nida-awards.org
SITE_URL=https://nida-awards.org

# Optional: a long random code (16+ characters) for /admin/recover if every admin is locked out.
# Leave empty normally.
ADMIN_SETUP_TOKEN=
