# ─────────────────────────────────────────────────────────────────────────────
# NIDA Awards website: settings for the Hostinger web app (hPanel → Environment variables →
# Import .env). Fill in a git-ignored copy (.env.hostinger), never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Neon: the NEW project → Connect → "Connection pooling" on → copy the string
DATABASE_URL=

# Neon Object Storage bucket (S3 API). The bucket stays private: the website serves
# public images itself from /uploads/...
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Amazon SES (the domain nida-awards.org must be verified in this region)
SES_REGION=us-east-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
EMAIL_FROM="NIDA Awards <admin@nida-awards.org>"
EMAIL_REPLY_TO=

# The website address (emailed links, share previews, sitemap)
ADMIN_URL=https://nida-awards.org
SITE_URL=https://nida-awards.org

# Optional: a long random code (16+ characters) for /admin/recover if every admin is locked out
ADMIN_SETUP_TOKEN=
